.role-row {
  margin-bottom: 18rpx;
}

.role-row .tag {
  min-width: 140rpx;
  text-align: center;
}

.inline-fields {
  display: flex;
  gap: 16rpx;
}

.inline-fields .input,
.inline-fields .picker {
  flex: 1;
  min-width: 0;
}

.province-fixed {
  display: flex;
  align-items: center;
  background: #f2f4f7;
  color: #475467;
}

.city-picker {
  width: 100%;
  box-sizing: border-box;
}

.picker-placeholder {
  color: #98a2b3;
}

.batch-data-summary {
  margin-top: 12rpx;
}

.batch-warning {
  margin-top: 12rpx;
}
