<view class="container">
  <view wx:if="{{trackLabel}}" class="track-banner">来自河南{{trackLabel}}专区，已预选对应考试类别</view>

  <view class="card">
    <view class="section-title">身份选择</view>
    <view class="tag-row role-row">
      <text class="tag {{form.role === '学生' ? 'active' : ''}}" data-role="学生" bindtap="selectRole">学生</text>
      <text class="tag {{form.role === '家长' ? 'active' : ''}}" data-role="家长" bindtap="selectRole">家长</text>
    </view>
    <view class="sub-text">家长身份需绑定学生后，可辅助查看、修改和对比志愿方案。</view>
  </view>

  <view class="card">
    <view class="section-title">基础信息</view>
    <view class="form-item">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名" value="{{form.name}}" data-field="name" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input" type="number" placeholder="用于保存方案和身份绑定" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
    </view>
    <view class="form-item">
      <text class="label">省份 / 城市</text>
      <view class="inline-fields">
        <input class="input" placeholder="例如：浙江" value="{{form.province}}" data-field="province" bindinput="onInput" />
        <input class="input" placeholder="例如：杭州" value="{{form.city}}" data-field="city" bindinput="onInput" />
      </view>
    </view>
    <view class="form-item">
      <text class="label">选科组合</text>
      <picker mode="selector" range="{{subjectOptions}}" value="{{subjectIndex}}" bindchange="onSubjectChange">
        <view class="picker {{form.subjectCombination ? '' : 'picker-placeholder'}}">
          {{form.subjectCombination || '请选择选科组合'}}
        </view>
      </picker>
    </view>
    <view class="form-item" wx:if="{{isHenan}}">
      <text class="label">考试类别</text>
      <picker mode="selector" range="{{examTypeOptions}}" value="{{examTypeIndex}}" bindchange="onExamTypeChange">
        <view class="picker {{form.examType ? '' : 'picker-placeholder'}}">
          {{form.examType || '请选择考试类别'}}
        </view>
      </picker>
      <view class="sub-text">河南高考报名时艺术类 / 体育类二选一，不可同时报考两类统考提前批。</view>
    </view>

      <view class="form-item">
        <text class="label">高考分数 / 全省位次</text>
        <view class="inline-fields">
          <input class="input" type="number" placeholder="分数" value="{{form.score}}" data-field="score" bindinput="onInput" />
          <input class="input" type="number" placeholder="{{showArtSportsFields ? '位次可填0' : '位次'}}" value="{{form.rank}}" data-field="rank" bindinput="onInput" />
        </view>
        <view wx:if="{{showArtSportsFields}}" class="sub-text art-sports-hint">艺体无官方综合分位次，位次可填0；请勿套用普通类文化课位次做对标。</view>
      </view>

    <view wx:if="{{showArtSportsFields}}" class="card art-sports-card">
      <view class="section-title">{{form.examType === '艺术类' ? '艺术类' : '体育类'}}报考信息</view>
      <view class="form-item formula-field">
        <text class="label">院校综合分公式编号</text>
        <picker mode="selector" range="{{formulaOptions}}" value="{{form.formulaId - 1}}" bindchange="onFormulaChange">
          <view class="picker picker-formula">{{formulaOptions[form.formulaId - 1] || ('公式' + form.formulaId)}}</view>
        </picker>
        <view class="formula-hint" wx:if="{{formulaHints.length}}">{{formulaHints[form.formulaId - 1]}}</view>
        <view class="sub-text formula-desc">不同院校使用不同公式编号，此处为默认对标公式，可在专区按院校调整。</view>
      </view>
      <view class="form-item">
        <text class="label">专业统考分 {{form.examType === '艺术类' ? 'Z（满分300）' : 'T（满分150）'}}</text>
        <input class="input" type="digit" placeholder="请输入专业统考分" value="{{form.professionalScore}}" data-field="professionalScore" bindinput="onInput" />
      </view>
      <view class="form-item">
        <text class="label">双过线参考线（选填，用于投档校验）</text>
        <view class="inline-fields">
          <input class="input" type="number" placeholder="文化课控制线" value="{{form.cultureCutoff}}" data-field="cultureCutoff" bindinput="onInput" />
          <input class="input" type="number" placeholder="专业合格线" value="{{form.proCutoff}}" data-field="proCutoff" bindinput="onInput" />
        </view>
        <view class="sub-text">须同时过文化课控制线与专业统考合格线，才可投档对应本科志愿。</view>
      </view>
      <label class="checkbox-row waive-row">
        <checkbox value="1" checked="{{form.waiveArtSports}}" bindchange="onWaiveArtSportsChange" />
        <text class="checkbox-label">放弃艺体批次，仅用高考文化课走普通类批次</text>
      </label>
      <view wx:if="{{form.waiveArtSports}}" class="warn-box">
        已勾选放弃艺体：志愿填报将按普通类本科约48个院校专业组，不是艺术64个「专业+院校」平行志愿。
      </view>
      <view class="zone-link-row">
        <button class="secondary-btn zone-link-btn" size="mini" data-track="{{form.examType === '艺术类' ? 'art' : 'sports'}}" bindtap="goArtSportsZone">进入{{form.examType === '艺术类' ? '艺术' : '体育'}}报考专区</button>
      </view>
    </view>

    <view class="form-item">
      <text class="label">目标批次</text>
      <picker mode="selector" range="{{targetBatchOptions}}" value="{{targetBatchIndex}}" bindchange="onTargetBatchChange">
        <view class="picker {{form.targetBatch ? '' : 'picker-placeholder'}}">
          {{form.targetBatch || '请选择目标批次'}}
        </view>
      </picker>
      <view wx:if="{{batchDataSummary}}" class="sub-text batch-data-summary">{{batchDataSummary}}</view>
      <view wx:if="{{batchWarning}}" class="warn-box batch-warning">{{batchWarning}}</view>
    </view>

    <view wx:if="{{form.role === '家长'}}" class="form-item">
      <text class="label">绑定学生手机号 / 绑定码</text>
      <input class="input" placeholder="请输入学生手机号或绑定码" value="{{form.bindCode}}" data-field="bindCode" bindinput="onInput" />
    </view>

    <button class="primary-btn" bindtap="saveProfile">保存并进入</button>
  </view>
</view>
