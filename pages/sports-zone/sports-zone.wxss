.hero { background: linear-gradient(135deg, #0d9488, #2dd4bf); color: #fff; }
.hero .section-title, .hero .sub-text { color: #fff; }
.hero .warn-box { background: rgba(255,255,255,0.15); color: #fff; margin-top: 16rpx; }
.rule-item { font-size: 26rpx; color: #444; margin-bottom: 8rpx; }
.rhyme { margin-top: 16rpx; padding: 16rpx; background: #ecfdf5; border-radius: 12rpx; font-size: 24rpx; color: #0d9488; }
.form-item { margin-bottom: 24rpx; }
.label { display: block; font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.input, .picker { background: #f7f8fa; padding: 20rpx; border-radius: 12rpx; }
.inline-fields { display: flex; gap: 16rpx; }
.inline-fields .input { flex: 1; }
.btn-row { display: flex; gap: 16rpx; margin-top: 16rpx; }
.btn-row button { flex: 1; }
.checkbox-row { display: flex; align-items: center; font-size: 26rpx; margin: 0; }
.formula-field { margin-bottom: 8rpx; }
.picker-short { font-size: 28rpx; line-height: 1.5; }
.formula-hint { font-size: 24rpx; color: #888; margin-top: 8rpx; line-height: 1.5; word-break: break-all; }
.checkbox-row-wrap { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid #f0f0f0; }
.result-line { font-size: 40rpx; font-weight: 600; color: #0d9488; }
.tier-title { font-weight: 600; margin: 16rpx 0 8rpx; color: #333; }
.school-row { padding: 12rpx 0; border-bottom: 1px solid #f0f0f0; }
